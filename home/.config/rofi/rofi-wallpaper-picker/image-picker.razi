/*****----- Configuration -----*****/
@import "~/.config/rofi/colors.rasi"

configuration {
    modi:                       "drun";
    show-icons:                 true;
    display-drun:               " Apps";
    drun-display-format:        "{name}";
}

/*****----- Global Properties -----*****/
* {
    font:           "Pixel Code 12";
    background:     #00000050;
    background-alt: #10101090;
    foreground:     #FFFFFFFF;
    selected:       @primary-container;
    active:         #98C379FF;
    urgent:         #E06B74FF;
}
/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       100%;       /* Ocupa a tela toda */
    enabled:                     true;
    margin:                      80px;
    border-radius:               25px;
    padding:                     0px;
    background-color:            @background;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     40px;       /* Padding igual em todos os lados */
    background-color:            transparent;
    children:                    [ "listview" ];
}
/*****----- Listview -----*****/
listview {
    enabled:                     true;
    layout:                      horizontal; 
    cycle:                       false;       /* Loop infinito */
    dynamic:                     false;
    
    /* TRUQUE PARA A ORDEM: */
    lines:                       4;          /* Força apenas UMA linha horizontal */
    columns:                     100;        /* Permite até 100 colunas (wallpapers) nessa linha */
    
    fixed-height:                true;
    fixed-columns:               false;
    reverse:                     false;      /* Mantém a ordem da esquerda para a direita */
    
    spacing:                     20px;
    background-color:            transparent;
}



/*****----- Elements -----*****/
element {
    enabled:                     true;
    width:                       386px;      

    spacing:                     10px;
    padding:                     20px;
    border:                      2px solid;
    border-radius:               25px;
    border-color:                @selected;
    background-color:            @background;
    orientation:                 vertical;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            @background-alt;
}

element selected.normal {
    background-color:            @selected;
    border-color:                @foreground;
}

element-icon {
    background-color:            transparent;
    size:                        380px;      /* Tamanho interno da imagem */
    horizontal-align:            0.5;
}

element-text {
    background-color:            transparent;
    text-color:                  @on-surface;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}

/*****----- Message -----*****/
error-message {
    padding:                     50px;
    background-color:            @background;
    text-color:                  @foreground;
}
