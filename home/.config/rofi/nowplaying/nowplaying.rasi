/******---author @Harsh-bin Github --*****/
@import "~/.config/rofi/colors.rasi"
configuration {
    show-icons:                 false;
}


* {
    font: "Google Sans 14";

    background:                  @surface-container;         /* surface-container-low> */
    background-alt:              @surface-container;         /* surface-container */
    foreground:                  @on-surface;         /* on-surface */
    selected:                    @primary;         /* primary */
    active:                      @bg2;
    urgent:                      @fg3;
}
/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    southeast;
    anchor:                      center;
    fullscreen:                  false;
    width:                       500px;
    height:                      360px;
    x-offset:                    -700px;
    y-offset:                    -650px;
    enabled:                     true;
    cursor:                      "default";
    background-color:            @background;
    border:                      2px;
    border-color:                @selected;
    border-radius:               20px;
    padding:                     20px;
}

mainbox {
    enabled:                     true;
    spacing:                     20px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    ["top-message", "middle-wrapper", "listview" ];
}

top-message {
    enabled:                     true;
    padding:                     0px;
    background-color:            @background;
    children:                    [ "textbox-msg" ];
    expand:                      false;
}

textbox-msg {
    expand: true;
    background-color:            transparent;
    text-color:                  @foreground;
    horizontal-align:            0.5;
    vertical-align:              0.5;
    str:                         "  Now Playing";
    font:                        "Google Sans";
}

middle-wrapper {
    enabled:                     true;
    orientation:                 horizontal;
    spacing:                     20px;
    background-color:            transparent;
    expand:                      true;
    children:                    [ "album-art", "custom-text-box" ];
}

album-art {
    enabled:                     true;
    width:                       204px;
    height:                      170px;
    background-color:            @background;
    background-image:            url("~/.config/rofi/nowplaying/album_art.png", height); // change this path
    border-radius:               12px;
    expand:                      false;
}

album-art2 {
    enabled:                     true;
    width:                       200px;
    height:                      170px;
    background-color:            @background;
    background-image:            url("/home/repelente808/.config/rofi/nowplaying/teto.jpg", height); //>
    border-radius:               12px;
    expand:                      false;
}
custom-text-box {
    enabled:                     true;
    expand:                      true;
    padding:                     20px;
    background-color:            @background;
    border-radius:               12px;
    children:                    [ "textbox-custom" ];
}

textbox-custom {
    background-color:            transparent;
    text-color:                  @foreground;
    vertical-align:              0.5;
    horizontal-align:            0.5;
    markup:                      true;
    font:                        "Google Sans 14";
    str:                         "Loading...";
}

/*****-----(Buttons) -----*****/
listview {
    enabled:                     true;
    columns:                     3;
    lines:                       1;
    dynamic:                     true;
    reverse:                     false;
    spacing:                     15px;
    background-color:            transparent;
    cursor:                      "default";
    expand:                      false;
}

element {
    enabled:                     true;
    padding:                     12px;
    border-radius:               100%;
    cursor:                      pointer;
    background-color:            @background-alt;
    text-color:                  @foreground;
    orientation:                 horizontal;
}

element selected {
    background-color:            @selected;
    text-color:                  @background;
}


element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
    font:                        "Google Sans 14";
}
