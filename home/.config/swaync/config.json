	{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
	"cssPriority": "user",

  "control-center-width": 420,
  "control-center-height": 1024, 
  "control-center-margin-top": 2,
  "control-center-margin-bottom": 2,
  "control-center-margin-right": 1,
  "control-center-margin-left": 0,

  "notification-window-width": 400,
  "notification-icon-size": 48,
  "notification-body-image-height": 160,
  "notification-body-image-width": 200,

  "timeout": 4,
  "timeout-low": 2,
  "timeout-critical": 6,
  
  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": false,
  "script-fail-notify": true,
  "scripts": {
    "notification-sound": {
      "exec": "pw-play --volume=0.1 ~/.config/swaync/NotificationSound.wav ",
      "app-name": ".*"
    }
  },
  "notification-visibility": {
    "example-name": {
      "state": "muted",
      "urgency": "Low",
      "app-name": "Spotify"
    }
  },
  "widgets": [
    "label",
    "buttons-grid",
    "volume",
    "mpris",
    "title",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "volume": {
      "label": "  ",
      "show-per-app": false
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": " 󰎟 "
    },
    "dnd": {
      "text": "Do not disturb"
    },
    "label": {
      "max-lines": 1,
      "text": " "
    },
    "mpris": {
      "image-size": 96,
      "image-radius": 12,
      "autohide": true, 
      "max-visible": 1,
      "blacklist": ["YoutubeMusic"]
    },
    "volume": {
      "label": "󰕾",
        "show-per-app": true
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "",
          "command": "pactl set-source-mute @DEFAULT_SOURCE@ toggle && swaync-client -cp"
        },
        {
          "label": "",
          "command": "pactl set-sink-mute @DEFAULT_SINK@ toggle && swaync-client -cp"
        },
        {
          "label": "󰧶",
          "command": "sh -c 'swaync-client -cp; sleep 1; quicksnip'"
        },  
        {
          "label": "",
          "command": "sh -c 'sleep 1; hyprpicker -a' & swaync-client -cp"
        },
        {
          "label": "󰤨",
          "command": "~/.config/rofi/rofi-wifi-menu.sh & swaync-client -cp"
        },
        {
          "label": "󰈸",
          "command": "~/.config/swaync/power.sh & swaync-client -cp"       
        },
        {
          "label": "",
          "command": "~/.config/rofi/menu.sh & swaync-client -cp"
	}
      ]
    }
  }
}

