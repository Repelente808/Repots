{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "$HOME/.config/fastfetch/bocchi.gif",
        "type": "kitty-icat",
        "width": 20,
        "height": 10,
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "display": {
      "separator": "  "
    },
    "modules": [

      {
        "type": "title",
        "format": "{#1}╭────── User : {#}{user-name-colored}"
      },
      {
        "type": "custom",
        "format": "{#1}│"
      },
      {
        "type": "os",
        "key": "{#separator}│  {#keys}󰣇 ",
        "format": "{2}"
      },
      {
        "type": "uptime",
        "key": "{#separator}│  {#keys}󰅐 "
      },
      {
        "type": "wm",
        "key": "{#separator}│  {#keys}󱂬 ",
        "format": "{2}"
      },
      {
        "type": "cpu",
        "key": "{#separator}│  {#keys}󰻠 ",
        "format": "{1}"
      },
      {
        "type": "gpu",
        "key": "{#separator}│  {#keys}󰢮 ",
        "format": "{2}"
      },
      {
        "type": "memory",
        "key": "{#separator}│  {#keys}󰍛 ",
      },
      {
        "type": "custom",
        "format": "{#1}│"
      },
      // Colors
      {
        "type": "colors",
        "key": "{#separator}│",
        "symbol": "circle"
      },
      // Footer
      {
        "type": "custom",
        "format": "{#1}╰───────────────────────────────╯"
      }
    ]
  }
