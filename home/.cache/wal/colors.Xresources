! X colors.
! Generated by 'wal'
*foreground:        #c6c7ca
*background:        #1e212b
*.foreground:       #c6c7ca
*.background:       #1e212b
emacs*foreground:   #c6c7ca
emacs*background:   #1e212b
URxvt*foreground:   #c6c7ca
XTerm*foreground:   #c6c7ca
UXTerm*foreground:  #c6c7ca
URxvt*background:   [100]#1e212b
XTerm*background:   #1e212b
UXTerm*background:  #1e212b
URxvt*cursorColor:  #c6c7ca
XTerm*cursorColor:  #c6c7ca
UXTerm*cursorColor: #c6c7ca
URxvt*borderColor:  [100]#1e212b

! Colors 0-15.
*.color0: #1e212b
*color0:  #1e212b
*.color1: #9EA0A0
*color1:  #9EA0A0
*.color2: #D9CBA3
*color2:  #D9CBA3
*.color3: #A6AECA
*color3:  #A6AECA
*.color4: #92D8DA
*color4:  #92D8DA
*.color5: #DDDDDD
*color5:  #DDDDDD
*.color6: #F6F8FC
*color6:  #F6F8FC
*.color7: #c6c7ca
*color7:  #c6c7ca
*.color8: #656a7b
*color8:  #656a7b
*.color9: #9EA0A0
*color9:  #9EA0A0
*.color10: #D9CBA3
*color10:  #D9CBA3
*.color11: #A6AECA
*color11:  #A6AECA
*.color12: #92D8DA
*color12:  #92D8DA
*.color13: #DDDDDD
*color13:  #DDDDDD
*.color14: #F6F8FC
*color14:  #F6F8FC
*.color15: #c6c7ca
*color15:  #c6c7ca

! Black color that will not be affected by bold highlighting.
*.color66: #1e212b
*color66:  #1e212b

! Xclock colors.
XClock*foreground: #c6c7ca
XClock*background: #1e212b
XClock*majorColor:  rgba:c6/c7/ca/ff
XClock*minorColor:  rgba:c6/c7/ca/ff
XClock*hourColor:   rgba:c6/c7/ca/ff
XClock*minuteColor: rgba:c6/c7/ca/ff
XClock*secondColor: rgba:c6/c7/ca/ff

! Set depth to make transparency work.
URxvt*depth: 32
