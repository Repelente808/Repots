{
    "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
    "name": "pywal",
    "author": "pywal",
    "themes": [
        {
            "name": "pywal",
            "appearance": "dark",
            "style": {
                "background": "#1e212b90",
                "editor.background": "#1e212b90",
                "editor.foreground": "#c6c7ca",
                "text": "#c6c7ca",
                "text.muted": "#c6c7ca70",
                "text.ignored": "#c6c7ca40",
                "text.placeholder": "#c6c7ca50",
                "ignored": "#c6c7ca30",
                "element.hover": "#c6c7ca30",
                "ghost_element.hover": "#9EA0A030",
                "ghost_element.selected": "#9EA0A030",
                "ghost_element.active": "#9EA0A060",
                "border": "#1e212b",
                "editor.highlighted_line.background": "#9EA0A010",
                "editor.active_line.background": "#9EA0A010",
                "panel.background": "#1e212b90",
                "title_bar.background": "#1e212b90",
                "title_bar.inactive_background": "#1e212b90",
                "status_bar.background": "#1e212b90",
                "drop_target.background": "#1e212b90",
                "elevated_surface.background": "#1e212b",
                "toolbar.background": "#1e212b90",
                "tab_bar.background": "#1e212b90",
                "tab.inactive_background": "#1e212b90",
                "tab.active_background": "#9EA0A030",
                "scrollbar.track.background": "transparent",
                "scrollbar.track.border": "#1e212b",
                "scrollbar.thumb.background": "#9EA0A0",
                "editor.gutter.background": "#1e212b90",
                "terminal.background": "#1e212b10",
                "terminal.foreground": "#c6c7ca",
                "terminal.dim_foreground": "#c6c7ca",
                "terminal.bright_foreground": "#c6c7ca",
                "terminal.ansi.black": "#1e212b",
                "terminal.ansi.red": "#9EA0A0",
                "terminal.ansi.green": "#D9CBA3",
                "terminal.ansi.yellow": "#A6AECA",
                "terminal.ansi.blue": "#92D8DA",
                "terminal.ansi.magenta": "#DDDDDD",
                "terminal.ansi.cyan": "#F6F8FC",
                "terminal.ansi.white": "#c6c7ca",
                "terminal.ansi.bright_black": "#656a7b",
                "terminal.ansi.bright_red": "#9EA0A0",
                "terminal.ansi.bright_green": "#D9CBA3",
                "terminal.ansi.bright_yellow": "#A6AECA",
                "terminal.ansi.bright_blue": "#92D8DA",
                "terminal.ansi.bright_magenta": "#DDDDDD",
                "terminal.ansi.bright_cyan": "#F6F8FC",
                "terminal.ansi.bright_white": "#c6c7ca",
                "modified": "#9EA0A0",
                "syntax": {
                    "attribute": {
                        "color": "#9EA0A0"
                    },
                    "boolean": {
                      "color": "#D9CBA3"
                    },
                    "comment": {
                      "color": "#656a7b"
                    },
                    "comment.doc": {
                      "color": "#656a7b"
                    },
                    "constant": {
                      "color": "#D9CBA3"
                    },
                    "function": {
                      "color": "#F6F8FC"
                    },
                    "keyword": {
                      "color": "#92D8DA"
                    },
                    "number": {
                      "color": "#DDDDDD"
                    },
                    "operator": {
                      "color": "#92D8DA"
                    },
                    "string": {
                      "color": "#9EA0A0"
                    },
                    "variable": {
                      "color": "#D9CBA3"
                    }
                },
                "players": [
                  {
                    "cursor": "#9EA0A0",
                    "background": "#1e212b",
                    "selection": "#9EA0A030"
                  }
                ]
            }
        }
    ]
}
